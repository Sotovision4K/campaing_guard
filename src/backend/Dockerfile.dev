# Development Dockerfile with debugging support
FROM node:20-alpine

WORKDIR /app

# Install all dependencies (including devDependencies)
COPY package.json package-lock.json ./
RUN npm ci

# Copy TypeScript config
COPY tsconfig.json ./

# Source code is expected to be mounted at runtime via docker-compose volume,
# but we copy it here as a fallback for standalone builds.
COPY src ./src

# Expose API port and Node inspector port
EXPOSE 8080 9229

# Default command enables the V8 inspector on 0.0.0.0:9229
# The --inspect flag allows Chrome DevTools / VS Code to attach.
CMD ["npx", "tsx", "watch", "--inspect=0.0.0.0:9229", "src/app.ts"]
